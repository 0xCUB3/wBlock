<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Downloaded %d updates</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Загружено %d обновление</string>
			<key>other</key>
			<string>Загружено %d обновления</string>
			<key>few</key>
			<string>Загружено %d обновления</string>
			<key>many</key>
			<string>Загружено %d обновлений</string>
		</dict>
	</dict>
	<key>Updated %d filters</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Обновлён %d фильтр</string>
			<key>few</key>
			<string>Обновлено %d фильтра</string>
			<key>many</key>
			<string>Обновлено %d фильтров</string>
			<key>other</key>
			<string>Обновлено %d фильтра</string>
		</dict>
	</dict>
	<key>Updated %d scripts</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Обновлён %d скрипт</string>
			<key>other</key>
			<string>Обновлено %d скрипта</string>
			<key>few</key>
			<string>Обновлено %d скрипта</string>
			<key>many</key>
			<string>Обновлено %d скриптов</string>
		</dict>
	</dict>
	<key>Preparing %d extensions</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Подготовка %d расширения</string>
			<key>other</key>
			<string>Подготовка %d расширения</string>
			<key>few</key>
			<string>Подготовка %d расширений</string>
			<key>many</key>
			<string>Подготовка %d расширений</string>
		</dict>
	</dict>
	<key>Every %d days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Каждый %d день</string>
			<key>other</key>
			<string>Каждые %d дня</string>
			<key>few</key>
			<string>Каждые %d дня</string>
			<key>many</key>
			<string>Каждые %d дней</string>
		</dict>
	</dict>
	<key>Every %d hours</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Каждый %d час</string>
			<key>other</key>
			<string>Каждые %d часа</string>
			<key>few</key>
			<string>Каждые %d часа</string>
			<key>many</key>
			<string>Каждые %d часов</string>
		</dict>
	</dict>
</dict>
</plist>
